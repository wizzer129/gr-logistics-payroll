{
	"name": "gr-logistics",
	"private": true,
	"type": "module",
	"workspaces": [
		"frontend",
		"backend"
	],
	"scripts": {
		"dev": "bun run --filter '*' --parallel dev",
		"dev:frontend": "bun --cwd frontend run dev",
		"dev:backend": "bun --cwd backend run dev",
		"lint": "eslint .",
		"format": "prettier --write .",
		"test:frontend": "bun --cwd frontend run test",
		"test:backend": "bun --cwd backend run test"
	},
	"devDependencies": {
		"eslint": "^9.0.0",
		"@eslint/js": "^9.0.0",
		"typescript-eslint": "^8.0.0",
		"eslint-plugin-vue": "^9.28.0",
		"prettier": "^3.0.0"
	}
}
