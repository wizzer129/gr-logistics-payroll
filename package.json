{
	"name": "gr-logistics",
	"private": true,
	"type": "module",
	"workspaces": [
		"frontend"
	],
	"scripts": {
		"dev": "concurrently -n api,web -c cyan.bold,magenta.bold --kill-others-on-fail \"bun run dev:backend\" \"bun run dev:frontend\"",
		"dev:frontend": "bun run --cwd frontend dev",
		"dev:backend": "cd backend && cargo run",
		"lint": "eslint .",
		"format": "prettier --write .",
		"test:frontend": "bun run --cwd frontend test",
		"test:backend": "cd backend && set -a && . ./.env.development && set +a && cargo test",
		"migrate": "cd backend && cargo run -- migrate",
		"create-user": "cd backend && cargo run -- create-user"
	},
	"devDependencies": {
		"@eslint/js": "^9.0.0",
		"concurrently": "^10.0.6",
		"eslint": "^9.0.0",
		"eslint-plugin-vue": "^9.28.0",
		"prettier": "^3.0.0",
		"typescript-eslint": "^8.0.0"
	}
}
