# @plugin(@varlock/proton-pass-plugin)
# @initProtonPass()
# @defaultSensitive=false
#
# Source of truth for the backend's env keys: must list exactly REQUIRED_KEYS + OPTIONAL_KEYS
# from src/config.rs (tests/env_schema.rs enforces it). Values here are the dev defaults;
# secrets come from Proton Pass. Run with `varlock run -- <cmd>` (the root bun scripts do).
# ---

# @required @type=enum(development, production)
NODE_ENV=development

# @required @type=port
PORT=3000

# @required @type=string
DATABASE_URL=postgres://gr_logistics:dev_password@localhost:5432/gr_logistics

# @required @type=number(isInt=true)
SESSION_TTL_HOURS=12

# Exact origin the frontend is served from (credentialed CORS can't use "*").
# @required @type=url
CORS_ORIGIN=http://localhost:5173

# @required @type=string
LOG_LEVEL=DEBUG

# Optional — defaults to pretty in development, json otherwise.
# @type=enum(pretty, json)
LOG_FORMAT=pretty
