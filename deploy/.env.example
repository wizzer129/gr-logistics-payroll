# Read by docker compose itself (variable substitution), not passed to the backend.

# Goes into DATABASE_URL unescaped, so keep it URL-safe — e.g. `openssl rand -hex 32`.
POSTGRES_PASSWORD=

# Nginx Proxy Manager's Docker network (`docker network ls`).
NPM_NETWORK=npm_default

# `latest`, or a `sha-<short>` tag CI pushed, to pin or roll back.
BACKEND_IMAGE_TAG=latest
