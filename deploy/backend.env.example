# The backend's environment — the keys in backend/.env.schema, minus DATABASE_URL (compose
# builds that from POSTGRES_PASSWORD in .env).

NODE_ENV=production
PORT=3000
SESSION_TTL_HOURS=12
# Exact origin the frontend is served from (no "*", no trailing slash).
CORS_ORIGIN=https://app.example.com
LOG_LEVEL=INFO
LOG_FORMAT=json
