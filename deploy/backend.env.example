# The backend's environment — the keys in backend/.env.schema, minus DATABASE_URL (compose
# builds that from POSTGRES_PASSWORD in .env) and PORT (fixed at 4444 in docker-compose.yml).

NODE_ENV=production
SESSION_TTL_HOURS=12
# Exact origin the frontend is served from (no "*", no trailing slash).
CORS_ORIGIN=https://gr-logistics.us
LOG_LEVEL=INFO
LOG_FORMAT=json
# Outgoing email (EMAIL-SPEC.md). The backend won't start in production without these.
EMAIL_PROVIDER=resend
EMAIL_FROM=GR Logistics <payroll@gr-logistics.us>
RESEND_API_KEY=