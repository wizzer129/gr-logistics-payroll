NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://gr_logistics:changeme@localhost:5432/gr_logistics

SESSION_TTL_HOURS=12

# Exact origin the frontend is served from (credentialed CORS can't use "*").
CORS_ORIGIN=http://localhost:5173

ANTHROPIC_API_KEY=changeme
# Optional — tests point this at a mock server.
ANTHROPIC_BASE_URL=https://api.anthropic.com

LOG_LEVEL=INFO
# Optional — pretty|json. Defaults to pretty in development, json otherwise.
LOG_FORMAT=pretty
